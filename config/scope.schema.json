{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.ctf-agent/scope.schema.json",
  "title": "CTF task scope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "authorized",
    "target_url",
    "allowed_hosts",
    "allowed_ports",
    "allowed_schemes"
  ],
  "properties": {
    "authorized": {
      "const": true
    },
    "target_url": {
      "type": "string",
      "pattern": "^https?://"
    },
    "allowed_hosts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_ports": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 65535
      }
    },
    "allowed_schemes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "http",
          "https"
        ]
      }
    },
    "allowed_redirect_hosts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "user_constraints": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
