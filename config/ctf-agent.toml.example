[project]
name = "scopeguard-ctf-agent"
version = "0.1.0"

[paths]
challenges = "challenges/current"
archive = "challenges/archive"
reports = "reports"
logs = "logs"
artifacts = "artifacts"

[network]
allowed_schemes = ["http", "https"]
default_request_timeout_seconds = 15
default_max_response_bytes = 2097152
follow_redirects = false
block_metadata_endpoints = true
scope_proxy_host = "127.0.0.1"
scope_proxy_port = 18080

[security]
require_explicit_authorization = true
allow_unrestricted_file_access = false
allow_host_environment_in_sandbox = false
allow_docker_socket_in_sandbox = false
max_attachment_bytes = 268435456

[sandbox]
broker_url = "http://127.0.0.1:8765"
default_network = "none"
allow_internet_by_default = false
max_concurrent = 2
container_timeout_seconds = 300
